{
  "name": "@your-scope/excel-diff-core",
  "version": "0.0.0",
  "description": "Framework-agnostic Excel and CSV parse and diff engine.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "clean": "rimraf dist .tsbuild",
    "generate:fixtures": "tsx ../../fixtures/generate.ts"
  },
  "dependencies": {
    "papaparse": "^5.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/papaparse": "^5.5.2",
    "@vitest/coverage-v8": "^2.1.1",
    "tsx": "^4.23.15"
  }
}
